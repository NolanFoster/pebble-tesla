{
  "name": "tesla-control",
  "author": "you",
  "version": "1.0.0",
  "keywords": ["pebble-app"],
  "private": true,
  "scripts": {
    "test": "jest",
    "test:js": "jest",
    "test:c": "make test-c",
    "test:all": "npm run test:js && npm run test:c"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "pebble": {
    "displayName": "Tesla Control",
    "uuid": "a1b2c3d4-e5f6-4a5b-8c7d-0e1f2a3b4c5d",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "capabilities": ["configurable"],
    "targetPlatforms": ["basalt", "chalk", "diorite", "emery"],
    "watchapp": {
      "watchface": false
    },
    "messageKeys": [
      "CMD",
      "STATUS",
      "BATTERY",
      "RANGE",
      "LOCKED",
      "CLIMATE_ON",
      "INSIDE_TEMP",
      "TARGET_TEMP",
      "ONLINE",
      "AWAKE",
      "NAME",
      "ERROR",
      "TEMP_DELTA",
      "PAINT_COLOR"
    ],
    "resources": {
      "media": [
        { "type": "bitmap", "name": "ICON_LOCKED",            "file": "images/locked.png" },
        { "type": "bitmap", "name": "ICON_UNLOCKED",          "file": "images/unlocked.png" },
        { "type": "bitmap", "name": "ICON_SETTINGS",          "file": "images/settings.png" },
        { "type": "bitmap", "name": "ICON_CLIMATE_ON",        "file": "images/climate_on.png" },
        { "type": "bitmap", "name": "ICON_CLIMATE_OFF",       "file": "images/climate_off.png" },
        { "type": "bitmap", "name": "ICON_LOCKED_DARK",       "file": "images/locked_black.png" },
        { "type": "bitmap", "name": "ICON_UNLOCKED_DARK",     "file": "images/unlocked_black.png" },
        { "type": "bitmap", "name": "ICON_SETTINGS_DARK",     "file": "images/settings_black.png" },
        { "type": "bitmap", "name": "ICON_CLIMATE_ON_DARK",   "file": "images/climate_on_black.png" },
        { "type": "bitmap", "name": "ICON_CLIMATE_OFF_DARK",  "file": "images/climate_off_black.png" }
      ]
    }
  }
}
