{
  "name": "tesla-control",
  "author": "Nolan Foster <nolanfoster@gmail.com>",
  "version": "1.0.0",
  "keywords": ["pebble-app"],
  "private": true,
  "scripts": {
    "test": "jest",
    "test:js": "jest",
    "test:c": "make test-c",
    "test:all": "npm run test:js && npm run test:c"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "pebble": {
    "displayName": "Tesla Control",
    "uuid": "a1b2c3d4-e5f6-4a5b-8c7d-0e1f2a3b4c5d",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "capabilities": ["configurable"],
    "targetPlatforms": ["basalt", "chalk", "diorite", "emery"],
    "watchapp": {
      "watchface": false
    },
    "messageKeys": [
      "CMD",
      "STATUS",
      "BATTERY",
      "RANGE",
      "LOCKED",
      "CLIMATE_ON",
      "INSIDE_TEMP",
      "TARGET_TEMP",
      "ONLINE",
      "AWAKE",
      "NAME",
      "ERROR",
      "TEMP_DELTA",
      "PAINT_COLOR"
    ],
    "resources": {
      "media": [
        { "type": "bitmap", "name": "IMAGE_MENU_ICON",        "file": "images/menu_icon.png", "menuIcon": true },
        { "type": "bitmap", "name": "ICON_LOCKED",            "file": "images/locked.png" },
        { "type": "bitmap", "name": "ICON_UNLOCKED",          "file": "images/unlocked.png" },
        { "type": "bitmap", "name": "ICON_SETTINGS",          "file": "images/settings.png" },
        { "type": "bitmap", "name": "ICON_CLIMATE_ON",        "file": "images/climate_on.png" },
        { "type": "bitmap", "name": "ICON_CLIMATE_OFF",       "file": "images/climate_off.png" },
        { "type": "bitmap", "name": "ICON_TEMP_UP",           "file": "images/temp_up.png" },
        { "type": "bitmap", "name": "ICON_TEMP_DOWN",         "file": "images/temp_down.png" },
        { "type": "bitmap", "name": "ICON_FRUNK",             "file": "images/frunk.png" },
        { "type": "bitmap", "name": "ICON_TRUNK",             "file": "images/trunk.png" },
        { "type": "bitmap", "name": "ICON_CHARGE",            "file": "images/charge.png" },
        { "type": "bitmap", "name": "ICON_REFRESH",           "file": "images/refresh.png" },
        { "type": "bitmap", "name": "ICON_LOCKED_DARK",       "file": "images/locked_black.png" },
        { "type": "bitmap", "name": "ICON_UNLOCKED_DARK",     "file": "images/unlocked_black.png" },
        { "type": "bitmap", "name": "ICON_SETTINGS_DARK",     "file": "images/settings_black.png" },
        { "type": "bitmap", "name": "ICON_CLIMATE_ON_DARK",   "file": "images/climate_on_black.png" },
        { "type": "bitmap", "name": "ICON_CLIMATE_OFF_DARK",  "file": "images/climate_off_black.png" },
        { "type": "bitmap", "name": "ICON_TEMP_UP_DARK",      "file": "images/temp_up_black.png" },
        { "type": "bitmap", "name": "ICON_TEMP_DOWN_DARK",    "file": "images/temp_down_black.png" },
        { "type": "bitmap", "name": "ICON_FRUNK_DARK",        "file": "images/frunk_black.png" },
        { "type": "bitmap", "name": "ICON_TRUNK_DARK",        "file": "images/trunk_black.png" },
        { "type": "bitmap", "name": "ICON_CHARGE_DARK",       "file": "images/charge_black.png" },
        { "type": "bitmap", "name": "ICON_REFRESH_DARK",      "file": "images/refresh_black.png" }
      ]
    },
    "publishedMedia": [
      { "name": "TESLA_GLANCE", "id": 1, "glance": "IMAGE_MENU_ICON" }
    ]
  }
}
